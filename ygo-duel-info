});

test('deck out loses the game', () => {
  let g = newGame();
  g.players[1].deck.length = 0;
  g.initialCounts[1] = 5; // keep the audit consistent with the edit above
  g = endTurn(g);
  assert.equal(g.result.winner, 0);
});

test('the audit catches a corrupted board', () => {
  const g = newGame();
  g.players[0].hand.push(structuredClone(g.players[0].hand[0])); // duplicate card
  assert.ok(audit(g).length > 0);
  const h = newGame();
  h.players[0].mzone[0] = h.players[0].deck.shift(); h.players[0].mzone[0].faceUp = true;
  h.players[0].mzone[0] = { ...h.players[0].mzone[0], id: 'pot_of_greed' }; // a Spell in a Monster Zone
  assert.ok(audit(h).some((p) => p.includes('illegally')));
});

test('fuzz: 150 random duels never break the rules audit', () => {
  for (let seed = 1; seed <= 150; seed++) {
    let g = createGame({ decks: [SAMPLE_DECK, SAMPLE_DECK], seed });
    let rng = seed;
    for (let step = 0; step < 1500 && !g.result; step++) {
      const legal = getLegalActions(g);
      assert.ok(legal.length > 0, `no legal actions at seed ${seed} step ${step}`);
      rng = (Math.imul(rng, 1103515245) + 12345) >>> 0;
      g = dispatch(g, legal[rng % legal.length]);
    }
    assert.deepEqual(audit(g), []);
  }
});
