// Hot-seat table: both players share one screen. A cover hides the hand whenever control passes.
import { createGame, getLegalActions, dispatch, describe, findCard, audit } from './engine.js';
import { CARDS } from './cards.js';
import { SAMPLE_DECK } from './decks.js';

let game, shownFor = -1;
const $ = (id) => document.getElementById(id);

function newDuel() { game = createGame({ decks: [SAMPLE_DECK, SAMPLE_DECK] }); shownFor = -1; render(); }

const cardHTML = (c, own, inHand = false) => {
  if (!c) return '';
  const d = CARDS[c.id], hidden = !c.faceUp && !inHand;
  if (hidden && !own) return '<div class="card down">face-down</div>';
  const stats = d.kind === 'monster' ? `<br>${d.atk}/${d.def} Lv${d.level}` : '';
  const pos = c.faceUp ? '' : ' (set)';
  return `<div class="card ${d.kind} ${hidden ? '' : ''} ${d.kind === 'monster' && c.pos === 'def' ? 'def' : ''}">${d.name}${pos}${stats}</div>`;
};
const zone = (c, own) => `<div class="zone">${cardHTML(c, own)}</div>`;

function side(p, viewer) {
  const pl = game.players[p], own = p === viewer;
  const pile = (label, n) => `<div class="zone label">${label}<br>${n}</div>`;
  const hand = own ? pl.hand.map((c) => cardHTML(c, true, true)).join('') : pl.hand.map(() => '<div class="card down">card</div>').join('');
  const monsters = `<div class="row">${pile('Graveyard', pl.gy.length)}${pl.mzone.map((c) => zone(c, own)).join('')}${pile('Banished', pl.banished.length)}</div>`;
  const spells = `<div class="row">${pile('Deck', pl.deck.length)}${pl.szone.map((c) => zone(c, own)).join('')}<div class="zone">${cardHTML(pl.field, own)}<small>Field</small></div></div>`;
  return `<div class="side"><h2><span>Player ${p + 1}${p === game.turnPlayer ? ' (turn)' : ''}</span><span class="lp">${pl.lp} LP</span></h2>
    ${p === viewer ? monsters + spells : spells + monsters}<div class="hand">${hand}</div></div>`;
}

function render() {
  if (!game) return;
  const viewer = game.priority;
  const problems = audit(game);
  $('board').innerHTML =
    (game.result ? `<div class="banner">Duel over: ${game.result.winner === null ? 'draw' : `Player ${game.result.winner + 1} wins`} — ${game.result.reason}.</div>` : '') +
    (problems.length ? `<div class="banner">Audit warning: ${problems.join('; ')}</div>` : '') +
    side(1 - viewer, viewer) +
    `<div class="mid">Turn ${game.turn} · Player ${game.turnPlayer + 1} · ${({ main1: 'Main Phase 1', battle: 'Battle Phase', main2: 'Main Phase 2', end: 'End Phase' })[game.phase]}</div>` +
    side(viewer, viewer);

  const acts = getLegalActions(game);
  $('who').textContent = game.result ? 'Duel finished' : `Player ${viewer + 1}: choose a move`;
  const order = ['summon', 'set', 'setST', 'flip', 'position', 'activate', 'attack', 'discard', 'phase', 'pass'];
  acts.sort((a, b) => order.indexOf(a.type) - order.indexOf(b.type));
  $('acts').innerHTML = '';
  for (const a of acts) {
    const b = document.createElement('button');
    b.textContent = describe(game, a);
    b.onclick = () => { try { game = dispatch(game, a); } catch (e) { alert(e.message); } render(); };
    $('acts').append(b);
  }
  $('chain').innerHTML = game.chain.length ? game.chain.map((l, i) => `Link ${i + 1}: ${CARDS[l.id].name}`).reverse().join('<br>') : 'Empty';
  $('log').innerHTML = game.log.slice(-25).reverse().join('<br>');

  // Hide the hand whenever control moves to the other player.
  if (!game.result && shownFor !== viewer) {
    shownFor = viewer;
    const cover = $('cover');
    cover.hidden = false;
    cover.innerHTML = `<h2>Player ${viewer + 1}, your move</h2><p>Pass the screen, then reveal your hand.</p><button id="reveal">Show my hand</button>`;
    $('reveal').onclick = () => { cover.hidden = true; };
  }
}

$('new').onclick = newDuel;
newDuel();
