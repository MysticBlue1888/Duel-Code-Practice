## 6. `src/rules.js`

````js
// Core numbers from the Master Rules (April 1, 2020 revision, the latest I could confirm).
// If Konami changes a rule, this is the first place to look.
export const RULES = {
  startingLP: 8000,
  startingHand: 5,
  handLimit: 6,            // checked at the End Phase
  mainDeckMin: 40,
  mainDeckMax: 60,
  extraDeckMax: 15,
  copyLimit: 3,            // overridden per card by the banlist you pass in
  zoneCount: 5,            // Monster Zones and Spell & Trap Zones
};

export const PHASES = ['main1', 'battle', 'main2', 'end'];
// Draw and Standby phases run automatically because no supported card uses them yet.

// Level 1-4: no Tribute. Level 5-6: 1 Tribute. Level 7+: 2 Tributes.
export const tributesNeeded = (level) => (level <= 4 ? 0 : level <= 6 ? 1 : 2);

// Check a deck list. `banlist` maps card id -> allowed copies (0, 1, 2). Load the current
// Forbidden & Limited list into it; the default is empty on purpose, see README.
export function validateDeck(mainIds, extraIds = [], banlist = {}) {
  const errors = [];
  if (mainIds.length < RULES.mainDeckMin) errors.push(`Main Deck has ${mainIds.length} cards; minimum is ${RULES.mainDeckMin}.`);
  if (mainIds.length > RULES.mainDeckMax) errors.push(`Main Deck has ${mainIds.length} cards; maximum is ${RULES.mainDeckMax}.`);
  if (extraIds.length > RULES.extraDeckMax) errors.push(`Extra Deck has ${extraIds.length} cards; maximum is ${RULES.extraDeckMax}.`);
  const counts = {};
  for (const id of [...mainIds, ...extraIds]) counts[id] = (counts[id] || 0) + 1;
  for (const [id, n] of Object.entries(counts)) {
    const limit = id in banlist ? banlist[id] : RULES.copyLimit;
    if (n > limit) errors.push(`${id}: ${n} copies, limit is ${limit}.`);
  }
  return errors;
}
````

## 7. `src/cards.js`

````js
// Card database. Plain monsters and Spells/Traps are just data.
// A card with an effect gets a few small functions:
//   canActivate(g, player, card) -> true/false     extra activation condition
//   targets(g, player, card)     -> [uids]         only for effects that target
//   resolve(g, link, api)                          what happens when the chain resolves
// `api` is the engine's toolbox (draw, destroy, specialSummon, ...), so cards never touch zones directly.
// Card text here is paraphrased shorthand for testing; check the real card before relying on it.

const mon = (name, level, atk, def) => ({ name, kind: 'monster', level, atk, def });

const stCards = (g, p) => {
  const out = [];
  for (const pl of g.players) {
    for (const c of pl.szone) if (c) out.push(c.uid);
    if (pl.field) out.push(pl.field.uid);
  }
  return out;
};

export const CARDS = {
  celtic_guardian: mon('Celtic Guardian', 4, 1400, 1200),
  giant_soldier: mon('Giant Soldier of Stone', 3, 1300, 2000),
  mystical_elf: mon('Mystical Elf', 4, 800, 2000),
  battle_ox: mon('Battle Ox', 4, 1700, 1000),
  axe_raider: mon('Axe Raider', 4, 1700, 1150),
  feral_imp: mon('Feral Imp', 4, 1300, 1400),
  summoned_skull: mon('Summoned Skull', 6, 2500, 1200),
  gaia: mon('Gaia The Fierce Knight', 7, 2300, 2100),
  dark_magician: mon('Dark Magician', 7, 2500, 2100),
  blue_eyes: mon('Blue-Eyes White Dragon', 8, 3000, 2500),

  pot_of_greed: {
    name: 'Pot of Greed', kind: 'spell', sub: 'normal', speed: 1,
    canActivate: (g, p) => g.players[p].deck.length >= 2,
    resolve: (g, link, api) => api.draw(g, link.player, 2),
  },
  dark_hole: {
    name: 'Dark Hole', kind: 'spell', sub: 'normal', speed: 1,
    resolve: (g, link, api) => {
      const all = g.players.flatMap((pl) => pl.mzone.filter(Boolean));
      for (const c of all) api.destroy(g, c.uid);
    },
  },
  monster_reborn: {
    name: 'Monster Reborn', kind: 'spell', sub: 'normal', speed: 1,
    canActivate: (g, p) => g.players[p].mzone.some((c) => !c),
    targets: (g) => g.players.flatMap((pl) => pl.gy.filter((c) => CARDS[c.id].kind === 'monster').map((c) => c.uid)),
    resolve: (g, link, api) => api.specialSummon(g, link.player, link.target),
  },
  mystical_typhoon: {
    name: 'Mystical Typhoon', kind: 'spell', sub: 'quickplay', speed: 2,
    targets: (g, p, card) => stCards(g, p).filter((u) => u !== card.uid),
    resolve: (g, link, api) => api.destroyIfOnField(g, link.target),
  },
  dust_tornado: {
    name: 'Dust Tornado', kind: 'trap', sub: 'normal', speed: 2,
    targets: (g, p) => stCards(g, p).filter((u) => g.players[1 - p].szone.some((c) => c && c.uid === u) || g.players[1 - p].field?.uid === u),
    resolve: (g, link, api) => api.destroyIfOnField(g, link.target),
  },
};
