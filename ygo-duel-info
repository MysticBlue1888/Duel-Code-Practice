## 9. `src/engine.js`

````js
// The duel engine. Three ideas keep it honest:
//  1. getLegalActions() lists every move the rules allow right now.
//  2. dispatch() only accepts a move that appears in that list (check #1).
//  3. dispatch() runs the move on a COPY of the game, audits the result, and only then
//     replaces the real game (check #2). A bug can never leave a half-broken board.
import { RULES, tributesNeeded } from './rules.js';
import { CARDS } from './cards.js';
import { validateDeck } from './rules.js';

export class IllegalAction extends Error {}
const opp = (p) => 1 - p;
const isMain = (g) => g.phase === 'main1' || g.phase === 'main2';
const free = (arr) => arr.filter((x) => !x).length;

// ---------- seeded randomness (same seed = same shuffle, which makes bugs reproducible) ----------
function rand(g) {
  g.seed = (g.seed + 0x6d2b79f5) | 0;
  let t = Math.imul(g.seed ^ (g.seed >>> 15), 1 | g.seed);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
}
function shuffle(g, arr) {
  for (let i = arr.length - 1; i > 0; i--) {
    const j = Math.floor(rand(g) * (i + 1));
    [arr[i], arr[j]] = [arr[j], arr[i]];
  }
}
const log = (g, msg) => { g.log.push(msg); if (g.log.length > 200) g.log.shift(); };

// ---------- setup ----------
export function createGame({ decks, seed = Date.now() | 0, firstPlayer, banlist = {} }) {
  const g = { seed, turn: 1, turnPlayer: 0, phase: 'main1', priority: 0, chain: [], passes: 0,
    window: null, result: null, log: [], players: [], initialCounts: [0, 0] };
  for (let p = 0; p < 2; p++) {
    const errors = validateDeck(decks[p], [], banlist);
    if (errors.length) throw new Error(`Player ${p + 1} deck is not legal: ${errors.join(' ')}`);
    for (const id of decks[p]) if (!CARDS[id]) throw new Error(`Unknown card id: ${id}`);
    const deck = decks[p].map((id, i) => ({ uid: `p${p}-${i}`, id, owner: p, faceUp: false, pos: 'atk',
      setTurn: -1, summonTurn: -1, attacked: false, posChanged: false }));
    shuffle(g, deck);
    g.initialCounts[p] = deck.length;
    g.players.push({ lp: RULES.startingLP, deck, hand: [], extra: [], gy: [], banished: [],
      mzone: Array(RULES.zoneCount).fill(null), szone: Array(RULES.zoneCount).fill(null),
      field: null, normalSummoned: false });
  }
  g.turnPlayer = firstPlayer ?? (rand(g) < 0.5 ? 0 : 1);
  for (let p = 0; p < 2; p++) draw(g, p, RULES.startingHand);
  startTurn(g);
  log(g, `Player ${g.turnPlayer + 1} goes first.`);
  return g;
}

function startTurn(g) {
  const pl = g.players[g.turnPlayer];
  pl.normalSummoned = false;
  for (const c of [...pl.mzone, ...pl.szone]) if (c) { c.attacked = false; c.posChanged = false; }
  g.phase = 'main1'; g.priority = g.turnPlayer; g.chain = []; g.passes = 0; g.window = null;
  if (g.turn > 1) draw(g, g.turnPlayer, 1); // the first player skips their first Draw Phase
  log(g, `Turn ${g.turn}: Player ${g.turnPlayer + 1}.`);
}

// ---------- card movement: every move goes through these helpers ----------
export function findCard(g, uid) {
  for (const p of [0, 1]) {
    const pl = g.players[p];
    for (const zone of ['hand', 'deck', 'extra', 'gy', 'banished', 'mzone', 'szone']) {
      const index = pl[zone].findIndex((c) => c && c.uid === uid);
      if (index >= 0) return { p, zone, index, card: pl[zone][index] };
    }
    if (pl.field && pl.field.uid === uid) return { p, zone: 'field', index: 0, card: pl.field };
  }
  return null;
}
function detach(g, uid) {
  const f = findCard(g, uid);
  if (!f) throw new Error(`Card ${uid} not found`);
  const pl = g.players[f.p];
  if (f.zone === 'mzone' || f.zone === 'szone') pl[f.zone][f.index] = null;
  else if (f.zone === 'field') pl.field = null;
  else pl[f.zone].splice(f.index, 1);
  return f.card;
}
function sendTo(g, uid, zone) { // 'gy' | 'hand' | 'banished' | 'deck' — always the OWNER's side
  const card = detach(g, uid);
  Object.assign(card, { faceUp: false, pos: 'atk', attacked: false, posChanged: false });
  g.players[card.owner][zone].push(card);
  return card;
}
const firstFree = (arr) => arr.findIndex((x) => !x);

function draw(g, p, n) {
  for (let i = 0; i < n; i++) {
    const pl = g.players[p];
    if (!pl.deck.length) { g.result = { winner: opp(p), reason: `Player ${p + 1} cannot draw (deck out)` }; return; }
    pl.hand.push(pl.deck.shift());
  }
}
function destroy(g, uid) { if (findCard(g, uid)) sendTo(g, uid, 'gy'); }
function destroyIfOnField(g, uid) {
  const f = findCard(g, uid);
  if (f && ['mzone', 'szone', 'field'].includes(f.zone)) sendTo(g, uid, 'gy');
}
function specialSummon(g, p, uid) {
  const f = findCard(g, uid);
  const slot = firstFree(g.players[p].mzone);
  if (!f || f.zone !== 'gy' || slot < 0) return;
  const card = detach(g, uid);
  Object.assign(card, { faceUp: true, pos: 'atk', summonTurn: g.turn });
  g.players[p].mzone[slot] = card;
}
const api = { draw, destroy, destroyIfOnField, specialSummon, sendTo };

// ---------- which cards can act right now ----------
function* combos(arr, k, start = 0, cur = []) {
  if (cur.length === k) { yield [...cur]; return; }
  for (let i = start; i < arr.length; i++) { cur.push(arr[i]); yield* combos(arr, k, i + 1, cur); cur.pop(); }
}

function stActivations(g, p) {
  const pl = g.players[p], out = [];
  const responding = g.chain.length > 0 || !!g.window;
  const topSpeed = g.chain.length ? g.chain[g.chain.length - 1].speed : 0;
  const sources = [
    ...pl.hand.map((c) => ({ c, from: 'hand' })),
    ...pl.szone.filter((c) => c && !c.faceUp).map((c) => ({ c, from: 'set' })),
    ...(pl.field && !pl.field.faceUp ? [{ c: pl.field, from: 'set' }] : []),
  ];
  for (const { c, from } of sources) {
    const d = CARDS[c.id];
    if (d.kind === 'monster') continue;
    if (responding && d.speed < Math.max(2, topSpeed)) continue;      // spell speed rule
    const needsWait = d.kind === 'trap' || d.sub === 'quickplay';     // must be Set a turn first
    if (from === 'hand') {
      if (d.kind === 'trap') continue;                                // Traps must be Set first
      if (d.sub === 'quickplay') { if (p !== g.turnPlayer) continue; }
      else if (responding || p !== g.turnPlayer || !isMain(g)) continue;
      if (d.sub !== 'field' && free(pl.szone) < 1) continue;
    } else if (needsWait) {
      if (c.setTurn >= g.turn) continue;
    } else if (responding || p !== g.turnPlayer || !isMain(g)) continue;
    if (d.canActivate && !d.canActivate(g, p, c)) continue;
    const ts = d.targets ? d.targets(g, p, c) : null;
    if (ts) { for (const t of ts) out.push({ type: 'activate', player: p, uid: c.uid, target: t }); }
    else out.push({ type: 'activate', player: p, uid: c.uid, target: null });
  }
  return out;
}

export function getLegalActions(g) {
  if (g.result) return [];
  const p = g.priority, pl = g.players[p], out = [];
  if (g.chain.length || g.window) return [...stActivations(g, p), { type: 'pass', player: p }];

  if (g.phase === 'end') { // hand limit: discard down before the turn can end
    for (const c of pl.hand) out.push({ type: 'discard', player: p, uid: c.uid });
    return out;
  }
  if (isMain(g)) {
    const mons = pl.mzone.filter(Boolean).map((c) => c.uid);
    for (const c of pl.hand) {
      const d = CARDS[c.id];
      if (d.kind === 'monster' && !pl.normalSummoned) {
        for (const t of combos(mons, tributesNeeded(d.level))) {
          if (free(pl.mzone) + t.length < 1) continue;
          out.push({ type: 'summon', player: p, uid: c.uid, tributes: t });
          out.push({ type: 'set', player: p, uid: c.uid, tributes: t });
        }
      } else if (d.kind !== 'monster') {
        if (d.sub === 'field' ? !pl.field : free(pl.szone) > 0) out.push({ type: 'setST', player: p, uid: c.uid });
      }
    }
    for (const c of pl.mzone) {
      if (!c) continue;
      if (!c.faceUp && c.setTurn < g.turn) out.push({ type: 'flip', player: p, uid: c.uid });
      if (c.faceUp && !c.posChanged && !c.attacked && c.summonTurn < g.turn) out.push({ type: 'position', player: p, uid: c.uid });
    }
  }
  out.push(...stActivations(g, p));
  if (g.phase === 'battle' && g.turn > 1) { // no attacks on the very first turn of the duel
    const enemies = g.players[opp(p)].mzone.filter(Boolean);
    for (const c of pl.mzone) {
      if (!c || !c.faceUp || c.pos !== 'atk' || c.attacked) continue;
      if (!enemies.length) out.push({ type: 'attack', player: p, attacker: c.uid, target: 'direct' });
      for (const e of enemies) out.push({ type: 'attack', player: p, attacker: c.uid, target: e.uid });
    }
  }
  const next = { main1: ['battle', 'end'], battle: ['main2', 'end'], main2: ['end'] }[g.phase];
  for (const to of next) out.push({ type: 'phase', player: p, to });
  return out;
}

// ---------- applying actions ----------
function placeMonster(g, p, card, faceUp) {
  const slot = firstFree(g.players[p].mzone);
  Object.assign(card, { faceUp, pos: faceUp ? 'atk' : 'def', setTurn: faceUp ? card.setTurn : g.turn, summonTurn: g.turn });
  g.players[p].mzone[slot] = card;
}

function battle(g, p, attackerUid, target) {
  const att = findCard(g, attackerUid).card;
  const A = CARDS[att.id].atk;
  att.attacked = true;
  const enemy = g.players[opp(p)], me = g.players[p];
  if (target === 'direct') { enemy.lp = Math.max(0, enemy.lp - A); log(g, `${CARDS[att.id].name} attacks directly for ${A}.`); return; }
  const t = findCard(g, target).card, td = CARDS[t.id];
  if (!t.faceUp) { t.faceUp = true; log(g, `${td.name} is flipped face-up.`); }
  const diff = A - (t.pos === 'atk' ? td.atk : td.def);
  log(g, `${CARDS[att.id].name} (${A}) attacks ${td.name} in ${t.pos === 'atk' ? 'Attack' : 'Defense'} Position.`);
  if (t.pos === 'atk') {
    if (diff > 0) { destroy(g, t.uid); enemy.lp = Math.max(0, enemy.lp - diff); }
    else if (diff < 0) { destroy(g, att.uid); me.lp = Math.max(0, me.lp + diff); }
    else { destroy(g, t.uid); destroy(g, att.uid); }
  } else if (diff > 0) destroy(g, t.uid);           // no piercing damage without a card that says so
  else if (diff < 0) me.lp = Math.max(0, me.lp + diff); // attacker's controller takes the difference
}

function resolveChain(g) {
  while (g.chain.length && !g.result) {
    const link = g.chain.pop(), d = CARDS[link.id];
    log(g, `Resolving ${d.name}.`);
    d.resolve(g, link, api);
    const f = findCard(g, link.uid);
    const spent = (d.kind === 'spell' && (d.sub === 'normal' || d.sub === 'quickplay')) || (d.kind === 'trap' && d.sub === 'normal');
    if (f && f.zone === 'szone' && spent) sendTo(g, link.uid, 'gy');
    checkResult(g);
  }
  g.passes = 0; g.window = null; g.priority = g.turnPlayer;
}

function requestPhase(g, p, to) { // the opponent only gets a window if they could actually do something
  const probe = { ...g, window: { kind: 'phase' }, chain: [], priority: opp(p) };
  if (stActivations(probe, opp(p)).length) { g.window = { kind: 'phase', next: to }; g.priority = opp(p); g.passes = 0; }
  else enterPhase(g, to);
}
function enterPhase(g, to) {
  g.phase = to;
  if (to === 'end' && g.players[g.turnPlayer].hand.length <= RULES.handLimit) endTurn(g);
}
function endTurn(g) {
  g.turnPlayer = opp(g.turnPlayer); g.turn++;
  startTurn(g);
}

function apply(g, a) {
  const p = a.player, pl = g.players[p];
  switch (a.type) {
    case 'summon': case 'set': {
      for (const t of a.tributes) sendTo(g, t, 'gy');
      const card = detach(g, a.uid);
      placeMonster(g, p, card, a.type === 'summon');
      pl.normalSummoned = true;
      log(g, a.type === 'summon' ? `Player ${p + 1} Normal Summons ${CARDS[card.id].name}.` : `Player ${p + 1} Sets a monster.`);
      break;
    }
    case 'flip': { const c = findCard(g, a.uid).card; Object.assign(c, { faceUp: true, pos: 'atk', summonTurn: g.turn }); log(g, `Flip Summon: ${CARDS[c.id].name}.`); break; }
    case 'position': { const c = findCard(g, a.uid).card; c.pos = c.pos === 'atk' ? 'def' : 'atk'; c.posChanged = true; break; }
    case 'setST': {
      const card = detach(g, a.uid), d = CARDS[card.id];
      card.faceUp = false; card.setTurn = g.turn;
      if (d.sub === 'field') pl.field = card; else pl.szone[firstFree(pl.szone)] = card;
      log(g, `Player ${p + 1} Sets a card.`);
      break;
    }
    case 'activate': {
      const f = findCard(g, a.uid), d = CARDS[f.card.id], card = f.card;
      if (f.zone === 'hand') {
        detach(g, a.uid);
        if (d.sub === 'field') { if (pl.field) sendTo(g, pl.field.uid, 'gy'); pl.field = card; }
        else pl.szone[firstFree(pl.szone)] = card;
      }
      card.faceUp = true;
      g.chain.push({ player: p, uid: card.uid, id: card.id, target: a.target, speed: d.speed });
      g.passes = 0; g.priority = opp(p);
      log(g, `Player ${p + 1} activates ${d.name}.`);
      break;
    }
    case 'attack': battle(g, p, a.attacker, a.target); break;
    case 'phase': requestPhase(g, p, a.to); break;
    case 'discard': sendTo(g, a.uid, 'gy'); if (pl.hand.length <= RULES.handLimit) endTurn(g); break;
    case 'pass':
      if (!g.chain.length && g.window) { const to = g.window.next; g.window = null; g.priority = g.turnPlayer; g.passes = 0; enterPhase(g, to); }
      else { g.passes++; if (g.passes >= 2) resolveChain(g); else g.priority = opp(g.priority); }
      break;
    default: throw new IllegalAction(`Unknown action type ${a.type}`);
  }
  checkResult(g);
}

function checkResult(g) {
  if (g.result) return;
  const [a, b] = g.players.map((x) => x.lp <= 0);
  if (a && b) g.result = { winner: null, reason: 'Both players reached 0 Life Points' };
  else if (a) g.result = { winner: 1, reason: 'Player 1 reached 0 Life Points' };
  else if (b) g.result = { winner: 0, reason: 'Player 2 reached 0 Life Points' };
}

// ---------- the second check: audit the board after every action ----------
export function audit(g) {
  const problems = [], seen = new Set();
  const counts = [0, 0];
  for (let p = 0; p < 2; p++) {
    const pl = g.players[p];
    if (!Number.isFinite(pl.lp) || pl.lp < 0) problems.push(`Player ${p + 1} has invalid Life Points ${pl.lp}`);
    if (pl.mzone.length !== RULES.zoneCount || pl.szone.length !== RULES.zoneCount) problems.push(`Player ${p + 1} has the wrong number of zones`);
    const place = (c, where, ok) => {
      if (!c) return;
      if (seen.has(c.uid)) problems.push(`${c.uid} appears twice`);
      seen.add(c.uid); counts[c.owner]++;
      if (!ok) problems.push(`${CARDS[c.id].name} (${c.uid}) is illegally in ${where}`);
      if (where === 'mzone' && !c.faceUp && c.pos !== 'def') problems.push(`Face-down ${c.uid} must be in Defense Position`);
      if (where === 'szone' && !c.faceUp && c.pos !== 'atk') problems.push(`${c.uid} has a bad position`);
    };
    for (const z of ['hand', 'deck', 'extra', 'gy', 'banished']) for (const c of pl[z]) place(c, z, true);
    for (const c of pl.mzone) place(c, 'mzone', c && CARDS[c.id].kind === 'monster');
    for (const c of pl.szone) place(c, 'szone', c && CARDS[c.id].kind !== 'monster' && CARDS[c.id].sub !== 'field');
    place(pl.field, 'field', pl.field && CARDS[pl.field.id].sub === 'field');
  }
  for (let p = 0; p < 2; p++) if (counts[p] !== g.initialCounts[p]) problems.push(`Player ${p + 1}'s cards changed from ${g.initialCounts[p]} to ${counts[p]}`);
  for (const l of g.chain) if (!seen.has(l.uid)) problems.push(`Chain link refers to missing card ${l.uid}`);
  if (!g.chain.length && !g.window && g.priority !== g.turnPlayer) problems.push('Priority is with the wrong player');
  return problems;
}

export function dispatch(game, action) {
  if (game.result) throw new IllegalAction('The duel is over.');
  const key = JSON.stringify(action);
  if (!getLegalActions(game).some((a) => JSON.stringify(a) === key)) throw new IllegalAction(`Not a legal action right now: ${key}`);
  const next = structuredClone(game);
  apply(next, action);
  const problems = audit(next);
  if (problems.length) throw new Error(`Rule audit failed, move rejected: ${problems.join('; ')}`);
  return next;
}

export function describe(g, a) {
  const nm = (uid) => { const f = findCard(g, uid); return f ? (f.card.faceUp || f.zone === 'hand' || a.player === f.p ? CARDS[f.card.id].name : 'a face-down card') : uid; };
  switch (a.type) {
    case 'summon': return `Normal Summon ${nm(a.uid)}${a.tributes.length ? ` (Tribute ${a.tributes.map(nm).join(' + ')})` : ''}`;
    case 'set': return `Set ${nm(a.uid)} face-down${a.tributes.length ? ` (Tribute ${a.tributes.map(nm).join(' + ')})` : ''}`;
    case 'flip': return `Flip Summon ${nm(a.uid)}`;
    case 'position': return `Change position of ${nm(a.uid)}`;
    case 'setST': return `Set ${nm(a.uid)}`;
    case 'activate': return `Activate ${nm(a.uid)}${a.target ? ` targeting ${nm(a.target)}` : ''}`;
    case 'attack': return `${nm(a.attacker)} attacks ${a.target === 'direct' ? 'directly' : nm(a.target)}`;
    case 'phase': return a.to === 'end' ? 'End turn' : `Go to ${a.to === 'battle' ? 'Battle Phase' : 'Main Phase 2'}`;
    case 'discard': return `Discard ${nm(a.uid)} (hand limit)`;
    case 'pass': return g.window ? 'Do nothing (let it go ahead)' : 'Pass (no response)';
    default: return a.type;
  }
}
