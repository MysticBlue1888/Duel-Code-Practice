const newGame = (seed = 1) => createGame({ decks: [SAMPLE_DECK, SAMPLE_DECK], seed, firstPlayer: 0 });
// Pull a specific card from a player's deck into their hand (test helper).
function give(g, p, id) {
  const pl = g.players[p];
  const i = pl.deck.findIndex((c) => c.id === id);
  assert.ok(i >= 0, `no ${id} left in deck`);
  const [c] = pl.deck.splice(i, 1);
  pl.hand.push(c);
  return c;
}
const pick = (g, pred) => { const a = getLegalActions(g).find(pred); assert.ok(a, 'expected legal action not found'); return a; };
const act = (g, pred) => dispatch(g, pick(g, pred));
// Put a face-up monster straight onto a field (test helper).
function field(g, p, id, { faceUp = true, pos = 'atk', slot = 0 } = {}) {
  const c = give(g, p, id);
  g.players[p].hand.splice(g.players[p].hand.indexOf(c), 1);
  Object.assign(c, { faceUp, pos, summonTurn: -1, setTurn: -1 });
  g.players[p].mzone[slot] = c;
  return c;
}
const toBattle = (g) => act(g, (a) => a.type === 'phase' && a.to === 'battle');
const endTurn = (g) => { g = act(g, (a) => a.type === 'phase' && a.to === 'end'); while (g.phase === 'end' && !g.result) g = dispatch(g, getLegalActions(g)[0]); return g; };

